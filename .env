# Nano Cloud Environment Configuration
# Copy this file to .env and edit it, or use the connect.sh script

# --- Worker Configuration ---

# The WebSocket URL of the Nano Cloud Gateway
# Use 'ws://localhost:8081' for local gateway
# Use 'wss://your-gateway.com' for remote gateway
RELAY_URL=ws://47.115.134.153:8081

# --- LLM Configuration (Required for Nano Agent) ---

# Your API Key for the LLM provider
# For OpenAI: sk-...
# For Anthropic: sk-ant-...
# For Ollama: (leave empty if no auth required)
NANO_API_KEY=62019820c8da44a6b7ce08bd79db75c9.1Hhur5Oz3joAmOJK

# The Base URL of the LLM API
# For OpenAI: https://api.openai.com/v1
# For Anthropic: https://api.anthropic.com/v1
# For Ollama: http://host.docker.internal:11434/v1
# For vLLM: http://host.docker.internal:8000/v1
NANO_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# The model name to use
# Examples: gpt-4o, claude-3-5-sonnet-20240620, llama3
NANO_MODEL=glm-4.7

# --- Optional Proxy Settings ---
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
DOCKERHUB_MIRROR=docker.m.daocloud.io
BASE_GOLANG_IMAGE=docker.m.daocloud.io/library/golang:1.24.4
BASE_LINUX_IMAGE=docker.m.daocloud.io/library/golang:1.24.4
DOCKER_CLI_VERSION=28.5.1
DOCKER_CLI_IMAGE=docker.m.daocloud.io/library/docker:28.5.1-cli
GOPROXY=https://goproxy.cn,direct
